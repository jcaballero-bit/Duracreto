// ─────────────────────────────────────────────────────────────────────────────
// DPCR-08 — Esquema de datos · FASE 1 (motor de programación y despacho)
//
// Solo se modelan las 9 tablas necesarias para el motor de asignación:
//   planteles, plantas, mixers, bombas, clientes, disenos_mezcla,
//   rutas_estandar, pedidos, viajes.
//
// Tablas del CLAUDE.md que NO pertenecen a esta fase (se agregarán después):
//   operadores (Fase 4), asesores (Fase 4), usuarios (Fase 3),
//   bitacora_auditoria (Fase 4).
// Por eso los campos que las referenciarían quedan OMITIDOS o como texto libre
// nullable, marcados con "// [fase futura]". No se pierde trabajo: cuando esas
// tablas existan, se convierten en relaciones reales con una migración aditiva.
//
// Nota SQLite: Prisma no soporta enum en SQLite, así que los campos de dominio
// cerrado (zona, estado, tipo_descarga) son String; los valores válidos se
// documentan en un comentario junto a cada campo y se validan en el servidor.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: la URL vive en prisma.config.ts (para Migrate/CLI) y el runtime
  // recibe la conexión vía driver adapter (@prisma/adapter-pg) en el constructor
  // de PrismaClient (ver lib/prisma.ts). No se declara `url` aquí a propósito.
  // Fase 3: Postgres local embebido en :5433 (antes SQLite). Ver scripts/pg.ts.
}

// ── Planteles ────────────────────────────────────────────────────────────────
// Los 7 planteles. La flota es 100% dinámica: agregar/quitar un plantel es una
// operación de datos, nunca un cambio de código.
model planteles {
  id                         Int    @id @default(autoincrement())
  nombre                     String @unique
  zona                       String // "Norte" | "Centro Sur"
  capacidad_dosificacion_m3h Int // capacidad total informativa del plantel
  // Ubicación geográfica del plantel (para el mapa de cobertura comercial).
  latitud  Float?
  longitud Float?

  // Hub de préstamo de flota de la zona. Los planteles sin flota propia
  // (Choloma, Villanueva, La Ceiba, Hazama) apuntan a su hub (Santa Marta /
  // Tegucigalpa). Un hub puede tener hub_id = null (él mismo es el hub).
  hub_id Int?
  hub    planteles?  @relation("HubDeZona", fields: [hub_id], references: [id])
  hijos  planteles[] @relation("HubDeZona")

  plantas       plantas[]
  mixers_base   mixers[]   @relation("MixerBase")
  bombas_base   bombas[]   @relation("BombaBase")
  camiones_base camiones[] @relation("CamionBase")
  pickups_base  pickups[]  @relation("PickupBase")
  pedidos       pedidos[]
  solicitudes   solicitudes_anticipadas[]
  usuarios_asignados User[] @relation("PlantelAsignadoUsuario")
  jefes         jefes_planta_planteles[] // Jefes de Planta asignados a este plantel (M2M)
  operadores_asignados operadores[] @relation("OperadorPlantel") // motoristas cuyo plantel habitual es este
  observaciones_dia observaciones_plantel[] // nota operativa del plantel por dia

  @@index([zona])
}

// Asignación de PROYECTOS (clientes) a un Laboratorista. El Laboratorista solo ve
// en Despacho los viajes de pedidos cuyo cliente le fue asignado (activo=true).
// Las gestiona el Jefe de Laboratorio.
// El Jefe de Laboratorio asigna un Laboratorista a cada PROGRAMA del día (pedido):
// cada fila es (pedido -> laboratorista). Un pedido tiene a lo sumo UN laboratorista
// (o ninguno). El día se deriva del pedido. Un mismo laboratorista puede tener
// varios pedidos, pero sus horarios (derivados de los viajes de cada pedido) no
// pueden traslaparse entre clientes distintos; se valida al asignar
// (ver lib/laboratorio/ventana.ts).
model asignaciones_laboratorista {
  id               Int      @id @default(autoincrement())
  pedido_id        Int // UNO O MAS laboratoristas por pedido (una fila por laboratorista)
  laboratorista_id String
  creado_por       String
  creado_en        DateTime @default(now())

  laboratorista User    @relation(fields: [laboratorista_id], references: [id], onDelete: Cascade)
  pedido        pedidos @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  // Un mismo laboratorista no se repite en el mismo pedido, pero un pedido puede tener
  // varios laboratoristas (proyectos grandes).
  @@unique([pedido_id, laboratorista_id])
  @@index([pedido_id])
  @@index([laboratorista_id])
}

// Planteles que un usuario Jefe de Planta tiene asignados (M2M). Un Jefe de Planta
// puede supervisar VARIOS planteles; el Administrador arma el conjunto desde Admin >
// Usuarios. Todo su acceso/edicion en Programacion/Despacho se filtra por CUALQUIERA
// de estos planteles (reemplaza el antiguo `plantel_asignado_id` single para ese rol;
// el Dosificador sigue usando plantel/planta asignados).
model jefes_planta_planteles {
  id         Int    @id @default(autoincrement())
  usuario_id String
  plantel_id Int

  usuario  User      @relation("JefePlantaPlanteles", fields: [usuario_id], references: [id], onDelete: Cascade)
  plantel  planteles @relation(fields: [plantel_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, plantel_id])
  @@index([usuario_id])
}

// Asignacion de un Laboratorista a la SALIDA de una PLANTA (control de calidad a la
// salida de la planta), por DIA. Es DISTINTA de `asignaciones_laboratorista` (que es
// por proyecto/pedido, control en obra). La gestiona el Jefe de Laboratorio (o el
// Gerente de Control de Calidad / Admin) y puede cambiarse varias veces el mismo dia.
// Admite VARIOS laboratoristas por planta y dia (turnos o apoyo) y lleva la
// observacion del turno. Sin validacion de traslape: es "quien esta en esta planta
// ahora".
model asignaciones_laboratorista_planta {
  id               Int      @id @default(autoincrement())
  laboratorista_id String
  planta_id        Int
  fecha            DateTime // dia (medianoche local)
  // Indicaciones del Jefe de Laboratorio / Gerente de Control de Calidad / Admin para
  // el turno en esa planta. El laboratorista asignado las VE (junto con su planta).
  observaciones    String?
  creado_por       String
  creado_en        DateTime @default(now())

  laboratorista User    @relation("LaboratoristaPlanta", fields: [laboratorista_id], references: [id], onDelete: Cascade)
  planta        plantas @relation(fields: [planta_id], references: [id], onDelete: Cascade)

  // Una planta puede tener VARIOS laboratoristas el mismo dia (turnos, apoyo); lo que
  // no se repite es la misma persona dos veces en la misma planta y dia.
  @@unique([planta_id, fecha, laboratorista_id])
  @@index([planta_id, fecha])
  @@index([laboratorista_id])
}

// Observacion del PLANTEL para un DIA: nota operativa que el Programador / Jefe de
// Planta / Admin escriben junto al plantel en la programacion manual (por ejemplo
// "Enviar 5 mixers a Choloma"). Se muestra al lado del nombre del plantel en Despacho
// en vivo y en el Programa DPCR-08. Sin fila para el dia, no se muestra nada.
model observaciones_plantel {
  id         Int      @id @default(autoincrement())
  plantel_id Int
  fecha      DateTime // dia (medianoche local)
  texto      String
  creado_por String
  creado_en  DateTime @default(now())

  plantel planteles @relation(fields: [plantel_id], references: [id], onDelete: Cascade)

  @@unique([plantel_id, fecha])
  @@index([fecha])
}

// Reasignación TEMPORAL (por día) de un Dosificador a otra planta. La crea el Jefe de
// Planta o el Programador (o Admin); el Dosificador NO elige nada, solo ve el
// resultado. La planta EFECTIVA de un Dosificador ese día = esta reasignación si
// existe para (dosificador, fecha), si no su `User.planta_predeterminada_id`. Solo
// una reasignación activa por dosificador y día (unique → upsert reemplaza).
model reasignaciones_dosificador_planta {
  id             Int      @id @default(autoincrement())
  dosificador_id String
  planta_id      Int
  fecha          DateTime // día (medianoche local)
  creado_por     String // usuario Jefe de Planta / Programador / Admin
  creado_en      DateTime @default(now())

  dosificador User    @relation(fields: [dosificador_id], references: [id], onDelete: Cascade)
  planta      plantas @relation(fields: [planta_id], references: [id], onDelete: Cascade)

  @@unique([dosificador_id, fecha])
  @@index([fecha])
}

// ── Plantas dosificadoras ──────────────────────────────────────────────────
// Un plantel puede tener 1 o 2 plantas simultáneas (Santa Marta y Tegucigalpa
// tienen 2). El límite de m³/h de la cascada de horarios es POR PLANTA.
model plantas {
  id            Int    @id @default(autoincrement())
  plantel_id    Int
  nombre        String
  capacidad_m3h Int // m³/h de esta planta (STALO 45, SANY 50, etc.)
  // Maniobra/posicionamiento del camión antes de dosificar (min). El tiempo de
  // carga = tiempo_alistamiento_min + volumen/capacidad_m3h*60.
  tiempo_alistamiento_min Int @default(5)

  plantel planteles @relation(fields: [plantel_id], references: [id])
  pedidos pedidos[]
  viajes  viajes[] // viajes dosificados en esta planta (un pedido puede repartirse)
  dosificadores User[] @relation("PlantaPredeterminadaUsuario") // Dosificadores cuya planta predeterminada es esta
  asignaciones_lab_planta asignaciones_laboratorista_planta[] // Laboratorista de control de salida
  reasignaciones_dosificador reasignaciones_dosificador_planta[] // reasignaciones de Dosificador a esta planta por día
  aperturas aperturas_planta[] // apertura excepcional de un dia concreto

  @@index([plantel_id])
}

// ── Apertura de planta por DIA ───────────────────────────────────────────────
// Hora a partir de la cual esa planta puede empezar a cargar ESE dia. Es una
// EXCEPCION puntual (p. ej. un vaciado grande que arranca a las 5:00 a.m.); si no
// hay fila para el dia, rige la apertura por defecto (clave `hora_apertura_min` en
// `configuracion`, 7:00 a.m.). Se guarda en MINUTOS desde medianoche para poder
// compararla sin depender de la zona horaria del registro.
model aperturas_planta {
  id                Int      @id @default(autoincrement())
  planta_id         Int
  fecha             DateTime // dia (medianoche local)
  hora_apertura_min Int // minutos desde medianoche (300 = 5:00 a.m.)
  creado_por        String
  creado_en         DateTime @default(now())

  planta plantas @relation(fields: [planta_id], references: [id], onDelete: Cascade)

  @@unique([planta_id, fecha])
  @@index([fecha])
}

// ── Configuración global (clave-valor) editable desde Administración ─────────
// Ajustes del sistema que no ameritan tabla propia. Hoy: `margen_minimo_hueco_min`
// (minutos mínimos de un hueco para ofrecerlo al relleno automático del motor de
// 2 pasadas). Se lee con fallback a un default en código si la clave no existe.
model configuracion {
  clave     String @id
  valor_int Int?
}

// ── Operadores (motoristas) ────────────────────────────────────────────────
model operadores {
  id     Int    @id @default(autoincrement())
  nombre String
  estado String @default("Disponible") // "Disponible" | "No disponible"

  // Plantel donde el operador trabaja normalmente (FK opcional). El MIXER habitual del
  // operador NO vive aqui: es la relacion inversa `mixers_asignados` (fuente unica =
  // mixers.operador_asignado_id), para no desincronizar el dato en dos lugares.
  plantel_asignado_id Int?
  plantel_asignado    planteles? @relation("OperadorPlantel", fields: [plantel_asignado_id], references: [id])

  mixers_asignados mixers[] @relation("OperadorMixer") // mixers cuyo motorista habitual es este
  viajes           viajes[] // viajes donde va este motorista

  @@index([estado])
  @@index([plantel_asignado_id])
}

// ── Mixers (camiones revolvedores) ─────────────────────────────────────────
model mixers {
  id              Int     @id @default(autoincrement())
  identificador   String? @unique // número de unidad que captura el usuario (opcional)
  placa           String? // placa de la unidad (opcional)
  marca           String
  capacidad_m3    Int // 8 | 10 | 12
  plantel_base_id Int
  estado          String  @default("Disponible") // "Disponible" | "En mantenimiento" | "Fuera de servicio"

  // Motorista habitual del mixer (catálogo). Nullable.
  operador_asignado_id Int?
  operador_asignado    operadores? @relation("OperadorMixer", fields: [operador_asignado_id], references: [id])

  plantel_base planteles @relation("MixerBase", fields: [plantel_base_id], references: [id])
  viajes       viajes[]

  @@index([plantel_base_id])
  @@index([estado])
  @@index([capacidad_m3])
}

// ── Capacidades reducidas (carga por pendiente/acceso difícil) ───────────────
// Config editable desde Administración (NO hardcodeada): mapea la capacidad NOMINAL
// del mixer a la capacidad EFECTIVA real utilizable cuando el acceso al proyecto no
// permite cargar al 100%. Un pedido con `carga_reducida = true` usa la efectiva.
// Precarga conocida: 8→6, 10→8, 12→10.
model capacidades_reducidas {
  id                    Int @id @default(autoincrement())
  capacidad_nominal_m3  Int @unique // capacidad física del mixer (8/10/12/…)
  capacidad_efectiva_m3 Int // carga real utilizable con acceso difícil
}

// ── Bombas ─────────────────────────────────────────────────────────────────
model bombas {
  id              Int    @id @default(autoincrement())
  identificador   String @unique
  estado          String @default("Disponible") // "Disponible" | "En mantenimiento" | "Fuera de servicio"
  plantel_base_id Int

  plantel_base planteles @relation("BombaBase", fields: [plantel_base_id], references: [id])
  pedidos      pedidos[]

  @@index([plantel_base_id])
  @@index([estado])
}

// Camiones: vehículo que remolca/mueve las bombas ESTACIONARIAS (no las pluma,
// que se mueven solas). Un camión puede mover varias bombas al día según
// distancia/tiempo; la asignación a cada bomba se coordina MANUAL (el motor no la
// reserva por ahora — ver CLAUDE.md). Aquí se controla su mantenimiento.
model camiones {
  id              Int     @id @default(autoincrement())
  identificador   String  @unique // número de unidad
  placa           String?
  estado          String  @default("Disponible") // "Disponible" | "En mantenimiento" | "Fuera de servicio"
  plantel_base_id Int

  plantel_base planteles @relation("CamionBase", fields: [plantel_base_id], references: [id])

  @@index([plantel_base_id])
  @@index([estado])
}

// Pickups: vehículos de apoyo (supervisión, traslado de personal). NO participan
// en el motor de asignación de viajes, pero llevan control de mantenimiento igual.
model pickups {
  id              Int     @id @default(autoincrement())
  identificador   String  @unique
  placa           String?
  estado          String  @default("Disponible")
  plantel_base_id Int

  plantel_base planteles @relation("PickupBase", fields: [plantel_base_id], references: [id])

  @@index([plantel_base_id])
  @@index([estado])
}

// Disponibilidad de flota: mantenimientos programados y bajas de servicio de
// CUALQUIER tipo de unidad (relación polimórfica por unidad_tipo + unidad_id, sin
// FK porque apunta a 4 tablas distintas). El motor excluye las unidades con un
// registro activo (Programado/En_curso) cuyo rango cubra la fecha del viaje.
model disponibilidad_flota {
  id           Int      @id @default(autoincrement())
  unidad_tipo  String // "Mixer" | "Bomba" | "Camion" | "Pickup"
  unidad_id    Int
  fecha_inicio DateTime // día de inicio (00:00)
  fecha_fin    DateTime // día de fin (inclusive)
  tipo_evento  String // "Mantenimiento_Programado" | "Fuera_de_Servicio" | "Otro"
  motivo       String?
  estado       String   @default("Programado") // "Programado" | "En_curso" | "Completado" | "Cancelado"
  creado_por   String
  creado_en    DateTime @default(now())

  @@index([unidad_tipo, unidad_id])
  @@index([estado])
  @@index([fecha_inicio, fecha_fin])
}

// ── Historial de estado de una unidad (cambio rápido día a día) ──────────────
// Cada cambio rápido de estado de una unidad (mixer/bomba/camión/pickup) queda
// registrado con fecha/hora, para consultar "qué estado tuvo cada día". Es el
// estado MOMENTÁNEO; la baja programada por rango de días sigue en
// `disponibilidad_flota`. Polimórfico por unidad_tipo + unidad_id (sin FK).
model historial_estado_unidad {
  id              Int      @id @default(autoincrement())
  unidad_tipo     String // "Mixer" | "Bomba" | "Camion" | "Pickup"
  unidad_id       Int
  estado_anterior String?
  estado_nuevo    String
  fecha_hora      DateTime @default(now())
  usuario         String?

  @@index([unidad_tipo, unidad_id])
  @@index([fecha_hora])
}

// ── Clientes ───────────────────────────────────────────────────────────────
model clientes {
  id        Int     @id @default(autoincrement())
  empresa   String
  proyecto  String? // opcional: hay clientes sin un proyecto (p. ej. remodelación propia)
  ubicacion String
  latitud   Float? // coordenada del proyecto / sitio de entrega
  longitud  Float?
  // Enlace de Google Maps que pegó el asesor (pin de la obra). Se guarda tal cual
  // porque reabrirlo es más preciso que reconstruir uno desde las coordenadas.
  google_maps_url String?
  // Cómo se capturó la ubicación: "GPS en sitio" | "Enlace de Maps" | "Manual".
  // `ubicacion_precision_m` = precisión (metros) reportada por el GPS del celular.
  ubicacion_origen      String?
  ubicacion_precision_m Float?
  ubicacion_capturada_en DateTime?
  contacto  String?
  telefono  String?
  // El asesor decide si el cliente está activo. Hay clientes que funden una sola
  // vez (se inactivan al terminar) y otros que funden por un período largo. Los
  // inactivos se ocultan de los listados operativos pero conservan su historial.
  activo    Boolean @default(true)
  asesor_id Int? // asesor comercial dueño del cliente (Fase 3)
  // Tiempos de referencia para la cascada del motor (antes vivían en la tabla
  // rutas_estandar, ya fusionada). Null = sin ruta → el motor usa el default y
  // lo marca visualmente (ver DEFAULTS en lib/motor).
  tiempo_viaje_referencia_min   Int?
  tiempo_regreso_referencia_min Int?

  asesor       asesores?                  @relation(fields: [asesor_id], references: [id])
  pedidos      pedidos[]
  solicitudes  solicitudes_anticipadas[]

  @@index([asesor_id])
}

// ── Asesores (vendedores) ────────────────────────────────────────────────────
// Un asesor puede estar vinculado a un usuario de sistema (usuario_auth_id) para
// que, con rol Asesor, vea/confirme solo los pedidos de SUS clientes.
model asesores {
  id              Int     @id @default(autoincrement())
  nombre          String
  correo          String?
  usuario_auth_id String? @unique // enlaza a User.id (rol Asesor)
  // Zona principal del asesor ("Norte" | "Centro Sur"). En Programa Semana un asesor
  // CON zona ve (solo lectura) las filas de otros asesores de SU misma zona, nunca
  // las de la otra zona. Un asesor SIN zona (null) ve todas (hasta que se le asigne).
  zona_asignada   String?

  usuario     User?                     @relation(fields: [usuario_auth_id], references: [id])
  clientes    clientes[]
  pedidos     pedidos[]
  solicitudes solicitudes_anticipadas[]
  metas       metas_asesor[]
}

// ── Metas de venta por asesor (dashboard comercial) ──────────────────────────
// Meta de m³ por asesor y mes. La configura el Gerente Comercial / Admin.
model metas_asesor {
  id         Int      @id @default(autoincrement())
  asesor_id  Int
  anio       Int
  mes        Int // 1-12
  meta_m3    Float
  creado_por String
  creado_en  DateTime @default(now())

  asesor asesores @relation(fields: [asesor_id], references: [id])

  @@unique([asesor_id, anio, mes]) // una meta por asesor y mes
  @@index([anio, mes])
}

// ── Diseños de mezcla ──────────────────────────────────────────────────────
model disenos_mezcla {
  id                   Int     @id @default(autoincrement())
  codigo               String  @unique // p.ej. "DIS-0013"
  // Resistencia a compresión en psi. Null para diseños por flexión (MR), donde
  // el psi no aplica y se usa `etiqueta_resistencia` (p.ej. "MR-600").
  resistencia_psi      Int?
  // Etiqueta a mostrar de la resistencia ("4,000" o "MR-600"). Si es null se
  // formatea `resistencia_psi` con separador de miles.
  etiqueta_resistencia String?
  tamano_agregado      String? // tamaño máximo de agregado, p.ej. "3/4\"", "1-1/2\""
  revenimiento         String // p.ej. "4 pulg"
  sacos_hielo_por_m3   Float   @default(0)
  aditivo_especial     String?

  pedidos pedidos[]
}


// ── Pedidos ────────────────────────────────────────────────────────────────
model pedidos {
  id                Int      @id @default(autoincrement())
  cliente_id        Int
  diseno_id         Int
  volumen_total_m3  Float
  hora_solicitada   DateTime // fecha + hora: define el DÍA y la hora objetivo del pedido
  plantel_id        Int
  planta_id         Int
  bomba_id          Int?
  tipo_descarga     String // "Canal directo" | "Bomba estacionaria" | "Bomba pluma"
  revenimiento      String? // rango de asentamiento ('3" a 4"'…'9" a 10"'), editable por Programador/Jefe de Planta
  // Tipo de servicio ("Normal" | "Servicio de Construcción"): lo elige el asesor en
  // la solicitud y filtra el catálogo de diseños de mezcla en Programación (Normal
  // -> códigos que empiezan con C/Pre; Servicio de Construcción -> códigos con Ser).
  tipo_servicio     String?
  sacos_hielo_por_m3 Int    @default(0) // control de temperatura (0 = sin control; 1-10)
  // ── Instrucciones de MUESTREO del laboratorio (las fija el Jefe de Laboratorio /
  //    Gerente de Control de Calidad / Admin desde /laboratorio; el Laboratorista
  //    asignado solo las consulta).
  muestras_ubicacion String? // "En obra" | "En planta": donde se elaboran los testigos
  muestras_cantidad  Int? // cuantos cilindros/muestras hay que elaborar
  asesor_id         Int? // asesor que gestiona el pedido (precargado del cliente, editable)
  // Orden de atención del pedido DENTRO de su plantel+fecha (1 = primero). Es la
  // base de la cola para la cascada de horarios; se asigna MAX+1 al crear y el
  // Programador puede reordenarlo (reacomoda el resto). Independiente por plantel
  // y por día.
  orden_dia         Int?
  // Hora de llegada FIJA: si true, la cascada respeta `hora_solicitada` como
  // llegada exacta (piso duro) y NO reprograma este pedido junto al resto
  // (para casos ocasionales: p. ej. un cliente que pide suministro por la tarde).
  hora_bloqueada    Boolean @default(false)
  // Reparto de carga entre plantas: en un plantel con 2 plantas dosificadoras,
  // true = los viajes del pedido se reparten entre AMBAS plantas (carga
  // simultánea, doble throughput); false = todos cargan en la planta elegida
  // (`planta_id`). En planteles de 1 planta no aplica (siempre esa planta).
  usar_ambas_plantas Boolean @default(false)
  // Carga SIMULTÁNEA: junto con `usar_ambas_plantas`, fuerza que el motor priorice
  // arrancar un viaje en CADA planta a la misma hora (paralelismo máximo), en vez de
  // dejar que cada viaje caiga en la planta con el próximo hueco (que puede terminar
  // secuencial). Solo aplica en planteles de 2 plantas.
  carga_simultanea   Boolean @default(false)
  // Carga REDUCIDA: por pendiente/acceso difícil, este pedido no permite cargar el
  // mixer al 100%. El motor usa la `capacidad_efectiva_m3` de `capacidades_reducidas`
  // (en vez de la carga segura normal) al combinar capacidades y asignar volumen.
  carga_reducida     Boolean @default(false)
  // TEMPORAL/REVERSIBLE — Override manual de hora de carga (solo Admin). Si tiene
  // valor y el flag PERMITIR_HORA_CARGA_MANUAL está activo, tras la cascada un
  // post-paso reubica los viajes de este pedido para que su carga arranque a esta
  // hora exacta, aunque choque con otro pedido. null = automático (cascada manda).
  // Con el flag apagado el campo se ignora por completo (no daña el motor).
  hora_carga_manual DateTime?
  // Minutos mínimos entre la llegada de un camión y el siguiente (restricción de
  // acceso/espacio del sitio). El motor lo usa para escalonar los viajes del
  // pedido; null = sin restricción especial.
  frecuencia_entre_camiones_min Int?
  // Tiempo de transporte (min) SOLO IDA hacia la obra; el regreso se asume igual.
  // Se precarga del cliente al programar pero el Programador puede ajustarlo por
  // pedido. Null = usa el tiempo del cliente (o el default si el cliente no tiene).
  tiempo_transporte_min Int?
  elemento          String? // elemento estructural (losa, columna, zapata, …)
  // Observaciones del pedido que escribe el Programador / Jefe de Planta / Admin.
  // Se muestran en Despacho en vivo (antes del primer viaje del cliente) y al pie del
  // bloque del cliente en el Programa DPCR-08. Antes este campo era "ubicacion_detalle".
  observaciones String?
  // Volumen ORIGINAL programado (snapshot al crear/reprogramar). Sirve para medir
  // "adiciones de volumen" en el día: si lo despachado supera este valor, la
  // diferencia es adición al programa. Backfill = volumen_total_m3 al migrar.
  volumen_programado Float?
  // ADICIÓN vs PROGRAMA. true = pedido creado desde "Despacho en vivo" (Adicionar
  // pedido): es una ADICION de ultimo momento, NO forma parte del Programa DPCR-08 y
  // todo su volumen cuenta como adicion (volumen_programado = 0). false = pedido de
  // "Programacion" (Nuevo pedido o conversion de solicitud): SI es parte del
  // programa y aparece en el DPCR-08.
  es_adicion           Boolean @default(false)
  // Estado del pedido a nivel de negocio: "Activo" | "Cancelado". Un pedido
  // cancelado se conserva (con su motivo) para el indicador comercial y la
  // bitácora, pero sale del programa/despacho activo.
  estado_pedido        String  @default("Activo")
  motivo_cancelacion   String? // "Clima o Lluvia" | "Cliente no está listo" | "Se fue con la competencia" | "Cancelado por el cliente" | "Otro"
  detalle_cancelacion  String? // texto libre cuando el motivo es "Otro"
  cancelado_por        String?
  fecha_cancelacion    DateTime?
  creado_por        String // [fase futura] pasará a FK usuarios; por ahora texto libre
  creado_en         DateTime @default(now())
  // asesor_id -> [fase futura] relación a asesores (Fase 4)

  cliente clientes       @relation(fields: [cliente_id], references: [id])
  diseno  disenos_mezcla @relation(fields: [diseno_id], references: [id])
  plantel planteles      @relation(fields: [plantel_id], references: [id])
  planta  plantas        @relation(fields: [planta_id], references: [id])
  bomba   bombas?        @relation(fields: [bomba_id], references: [id])
  asesor  asesores?      @relation(fields: [asesor_id], references: [id])
  viajes  viajes[]
  // Solicitud anticipada (proyección semanal) de la que nació este pedido, si aplica.
  solicitud solicitudes_anticipadas?
  // Laboratorista(s) asignado(s) a este programa (uno o varios, o ninguno).
  asignaciones_lab asignaciones_laboratorista[]
  // Preguntas generales del control de calidad (una vez por pedido/cliente/día).
  control_calidad_general control_calidad_general?

  @@index([plantel_id])
  @@index([planta_id])
  @@index([hora_solicitada])
}

// ── Solicitudes anticipadas (proyección semanal de asesores) ─────────────────
// Reemplaza el Excel semanal: cada celda (cliente × día) es una proyección
// PRELIMINAR del asesor (no un pedido formal). El Programador la convierte en un
// pedido real. Los datos fijos del cliente NO se duplican aquí (viven en clientes).
model solicitudes_anticipadas {
  id                     Int      @id @default(autoincrement())
  cliente_id             Int
  asesor_id              Int? // asesor dueño (= asesor del cliente); null si el cliente no tiene
  plantel_id             Int? // planta que atenderá esta proyección (puede variar por día)
  fecha_requerida        DateTime // día proyectado (se guarda a medianoche local)
  volumen_estimado_m3    Float?
  tipo_concreto_estimado String? // texto libre aproximado (el asesor no sabe el código exacto)
  revenimiento           String? // revenimiento estimado ('3" a 4"'…'9" a 10"')
  tipo_servicio          String? // "Normal" | "Servicio de Construcción"
  tipo_descarga_estimado String? // "Bomba" | "Directo" (sin bomba/mixer específico)
  sacos_hielo_por_m3     Int? // control de temperatura estimado (0-10)
  elemento               String? // elemento estructural (pavimento, losa, columna…)
  frecuencia_entre_camiones_min Int?
  observaciones          String?
  estado                 String   @default("Pendiente") // Pendiente | Programado | Descartada
  pedido_id              Int?     @unique // se llena al convertir en pedido real
  creado_por             String
  creado_en              DateTime @default(now()) // antiguedad: cuando el asesor la registro
  actualizado_en         DateTime? // ultima modificacion (no pisa creado_en)

  cliente clientes  @relation(fields: [cliente_id], references: [id])
  asesor  asesores? @relation(fields: [asesor_id], references: [id])
  plantel planteles? @relation(fields: [plantel_id], references: [id])
  pedido  pedidos?  @relation(fields: [pedido_id], references: [id])

  // Un cliente puede tener VARIAS proyecciones el mismo día (p. ej. 4000 para
  // muros y 5000 para losa), por eso NO hay unique por (cliente, fecha).
  @@index([cliente_id, fecha_requerida])
  @@index([fecha_requerida, estado])
  @@index([asesor_id])
}

// ── Viajes ─────────────────────────────────────────────────────────────────
// Un pedido genera N viajes (uno por mixer/carga). El motor asigna el mixer y
// calcula toda la cascada de horarios. hora_regreso_planta = momento en que el
// mixer específico vuelve a estar libre.
model viajes {
  id                    Int   @id @default(autoincrement())
  pedido_id             Int
  mixer_id              Int? // nullable: un viaje sugerido de refuerzo aún sin asignar
  capacidad_asignada_m3 Int // carga SEGURA de planeacion del mixer (fisica - margen, p. ej. 7/9/11)
  volumen_asignado_m3   Float // volumen PROGRAMADO de este viaje (dato del DPCR-08)
  // Volumen REAL cargado. NULL = se cargo lo programado. Despacho en vivo escribe
  // AQUI, nunca sobre `volumen_asignado_m3`: asi el Programa DPCR-08 no se modifica
  // cuando se despacha menos de lo programado (misma regla que `hora_*` vs `ts_*_real`).
  volumen_real_m3       Float?

  // Motorista del viaje. Se preselecciona con el operador del mixer y es
  // editable en Despacho (por si el habitual no está disponible ese día).
  operador_id Int?
  operador    operadores? @relation(fields: [operador_id], references: [id])

  // ── PROGRAMACIÓN (línea base del motor, Hito 2) ────────────────────────────
  // Calculados por la cascada de asignación. Son la LÍNEA BASE ACORDADA.
  // Despacho en vivo NUNCA debe escribir sobre estos campos.
  hora_solicitada       DateTime
  hora_inicio_carga     DateTime?
  hora_fin_carga        DateTime?
  hora_salida_planta    DateTime?
  hora_llegada_proyecto DateTime?
  hora_inicio_descarga  DateTime?
  hora_fin_descarga     DateTime?
  hora_regreso_planta   DateTime?

  // ── EJECUCIÓN REAL (Despacho en vivo) ──────────────────────────────────────
  // Sellados por el despachador al avanzar el estado, con la hora del SERVIDOR.
  // Todo lo real vive aquí; la programación de arriba queda intacta.
  ts_inicio_carga_real    DateTime?
  ts_fin_carga_real       DateTime? // se sella al salir de "En carga" (fin de carga físico)
  ts_salida_real          DateTime?
  ts_llegada_real         DateTime?
  ts_inicio_descarga_real DateTime?
  ts_fin_descarga_real    DateTime?
  ts_regreso_real         DateTime?

  estado               String  @default("Programado") // "Programado" | "En carga" | "En ruta" | "Descargando" | "Regresando" | "Completado" | "Cancelado"
  ajustado_manualmente Boolean @default(false)
  // true = hora FIJA puesta a mano: este viaje NO se mueve cuando se reajusta la
  // cola del cliente por frecuencia (el reajuste lo salta y avisa). Es por VIAJE;
  // `pedidos.hora_bloqueada` es la regla equivalente a nivel de pedido en el motor
  // automatico.
  hora_fija            Boolean @default(false)
  // true = viaje de ADICION: agregado con "Agregar viaje" en Despacho a un pedido de
  // programa (o cualquier viaje de un pedido es_adicion). Cuenta como adicion en las
  // metricas (via volumen suministrado) y NO se muestra en el Programa DPCR-08.
  es_adicion           Boolean @default(false)

  // Motivo de la asignación, para mostrar en la interfaz de prueba:
  // "Flota propia" | "Préstamo de zona" | "Refuerzo excepcional" | "Sin cubrir"
  motivo_asignacion String?

  // Marca que el tiempo de viaje/regreso se calculó con valores por defecto
  // porque el cliente no tiene ruta_estandar registrada (para resaltar en UI).
  ruta_por_defecto Boolean @default(false)

  // Campos de confirmación de asesor — se usan en Fase 4, nullable por ahora.
  estado_confirmacion     String? // "Pendiente" | "Confirmado" | "Rechazado"
  fecha_hora_confirmacion DateTime?
  usuario_confirmo        String?

  // Planta dosificadora de ESTE viaje. En planteles con 2 plantas (Santa Marta,
  // Tegucigalpa) un mismo pedido puede repartir sus viajes entre ambas. El motor la
  // asigna al crear (planta con el hueco libre más temprano) y el Despachador puede
  // cambiarla en vivo. Backfill = pedido.planta_id.
  planta_id Int?
  planta    plantas? @relation(fields: [planta_id], references: [id])

  pedido pedidos @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  mixer  mixers? @relation(fields: [mixer_id], references: [id])
  control_calidad control_calidad_viaje?

  @@index([pedido_id])
  @@index([mixer_id])
  @@index([estado])
  @@index([planta_id])
}

// ── Control de calidad (reporte formal por cliente/día) ──────────────────────
// Datos que captura el Laboratorista y que NO existen en otro dominio. Las horas
// (ts_*_real), volumenes y datos del pedido NO se recapturan: se leen de viajes/
// pedidos. Estas dos tablas guardan SOLO lo nuevo del control de calidad.

// Por VIAJE (una fila por viaje): revenimiento medido en obra + temperatura.
model control_calidad_viaje {
  id                  Int      @id @default(autoincrement())
  viaje_id            Int      @unique
  revenimiento_obra   Float? // pulgadas
  temperatura_concreto Float? // unidad configurable (ver lib/calidad/config.ts)
  laboratorista_id    String?
  creado_en           DateTime @default(now())
  actualizado_en      DateTime @default(now()) @updatedAt

  viaje         viajes @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  laboratorista User?  @relation("ControlCalidadViajeLab", fields: [laboratorista_id], references: [id])
}

// General, UNA vez por pedido (cliente/día): preguntas al finalizar el servicio.
model control_calidad_general {
  id               Int      @id @default(autoincrement())
  pedido_id        Int      @unique
  laboratorista_id String?
  observaciones    String?
  humedecio_area   Boolean  @default(false)
  vibro_concreto   Boolean  @default(false)
  m3_programados   Float? // se trae de pedidos.volumen_total_m3 (snapshot al guardar)
  m3_colocados     Float? // sugerido = suma volumen_asignado de viajes completados, editable
  aplico_aditivo   Boolean  @default(false)
  aditivo_unidades String? // relevante solo si aplico_aditivo = true
  uso_curador      Boolean  @default(false)
  existe_reclamo   Boolean  @default(false)
  detalle_reclamo  String? // relevante solo si existe_reclamo = true
  creado_en        DateTime @default(now())
  actualizado_en   DateTime @default(now()) @updatedAt

  pedido        pedidos @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  laboratorista User?   @relation("ControlCalidadGeneralLab", fields: [laboratorista_id], references: [id])
}

// ── Autenticación y roles (Fase 3) ───────────────────────────────────────────
// Modelos estándar de Auth.js (@auth/prisma-adapter) + extensiones del negocio:
// `passwordHash` (login por correo/contraseña), `activo` (desactivar acceso sin
// borrar), `zona` (para Programador/Despachador), y `roles` (multi-rol).
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // login por credenciales (bcrypt); null si solo usa Google
  activo        Boolean   @default(true)
  zona          String? // "Norte" | "Centro Sur" | null (aplica a Programador/Despachador)
  // Plantel específico asignado (aplica a JefePlanta/Dosificador: ven/operan solo
  // ese plantel — alcance más fino que por zona). Null para los demás roles.
  plantel_asignado_id Int?
  // Planta PREDETERMINADA del Dosificador (donde trabaja normalmente). Es su default;
  // un día puntual el Jefe de Planta/Programador puede reasignarlo a otra planta vía
  // `reasignaciones_dosificador_planta` (la planta efectiva del día = reasignación de
  // hoy si existe, si no la predeterminada). Null para los demás roles.
  planta_predeterminada_id Int?
  // Si true, el usuario DEBE cambiar su contraseña antes de operar (primer ingreso).
  // Los usuarios nuevos creados por el Admin nacen en true; se apaga al cambiarla.
  debe_cambiar_password Boolean @default(true)
  creado_en     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  roles    UserRole[]
  asesor   asesores? // 1:1 si este usuario es un asesor comercial
  plantel_asignado planteles? @relation("PlantelAsignadoUsuario", fields: [plantel_asignado_id], references: [id])
  planta_predeterminada plantas? @relation("PlantaPredeterminadaUsuario", fields: [planta_predeterminada_id], references: [id])
  asignaciones_lab asignaciones_laboratorista[] // proyectos asignados si es Laboratorista
  jefe_planteles   jefes_planta_planteles[] @relation("JefePlantaPlanteles") // planteles si es Jefe de Planta (M2M)
  asignaciones_lab_planta asignaciones_laboratorista_planta[] @relation("LaboratoristaPlanta") // plantas asignadas (control de calidad de salida)
  control_calidad_viajes  control_calidad_viaje[]   @relation("ControlCalidadViajeLab")
  control_calidad_generales control_calidad_general[] @relation("ControlCalidadGeneralLab")
  reasignaciones_dosificador reasignaciones_dosificador_planta[] // reasignaciones de planta por día (si es Dosificador)
}

// Un usuario puede tener más de un rol activo a la vez.
model UserRole {
  id     String @id @default(cuid())
  userId String
  rol    String // "Administrador" | "Programador" | "Despachador" | "Asesor"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rol])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Programa DPCR-08: historial de versiones generadas ───────────────────────
// Cada vez que alguien GENERA el PDF del Programa DPCR-08 se guarda aquí una
// version con el SNAPSHOT de los datos con los que se armó, de modo que el
// documento sea reproducible identico despues aunque la programacion cambie
// (documento controlado ISO). `version` es incremental por (fecha_programa, zona).
// `generado_por` es auditoria INTERNA (se ve en el historial de la app); NO se
// imprime en el documento, que lleva las etiquetas ISO fijas por cargo.
model programas_dpcr08 {
  id             Int      @id @default(autoincrement())
  fecha_programa DateTime // dia del programa (medianoche local)
  zona           String
  snapshot_json  Json // datos congelados con los que se genero el PDF
  generado_por   String
  ts_generado    DateTime @default(now())
  version        Int

  @@unique([fecha_programa, zona, version])
  @@index([fecha_programa, zona])
  @@index([ts_generado])
}

// ── Bitácora de auditoría ────────────────────────────────────────────────────
// Registro de cambios sensibles. Se usa plenamente en Fase 4; por ahora la
// corrección manual de horas reales en Despacho ya escribe aquí.
// `usuario` es texto libre hasta que exista autenticación (Fase 3).
model bitacora_auditoria {
  id              Int      @id @default(autoincrement())
  tabla_afectada  String
  registro_id     Int
  usuario         String
  fecha_hora      DateTime @default(now())
  campo_modificado String
  valor_anterior  String?
  valor_nuevo     String?
  motivo          String?

  @@index([tabla_afectada, registro_id])
}
