# Variables de entorno de DPCR-08. Copia a .env para desarrollo local, y
# configúralas en Netlify (Site settings → Environment variables) para producción.
# NUNCA subas el .env real al repositorio (está en .gitignore).

# ── Base de datos PostgreSQL ────────────────────────────────────────────────
# PRODUCCIÓN: cadena de conexión de tu Postgres administrado (Neon, Supabase,
# Railway, RDS…). Casi siempre requiere SSL: agrega ?sslmode=require al final.
# Ej.: postgresql://usuario:password@host:5432/duracreto?sslmode=require
#
# DESARROLLO local: se usa el Postgres embebido en :5433 (npm run db:up); si no
# defines DATABASE_URL, lib/prisma.ts cae al default local automáticamente.
DATABASE_URL=

# ── Autenticación (Auth.js v5) ──────────────────────────────────────────────
# Secreto para firmar los JWT de sesión. Genéralo con:  npx auth secret
# (o: openssl rand -base64 32). OBLIGATORIO en producción.
AUTH_SECRET=

# La app ya usa trustHost:true, así que normalmente NO necesitas AUTH_URL en
# Netlify. Si tu proveedor lo requiere, descomenta y pon la URL pública del sitio:
# AUTH_URL=https://tu-sitio.netlify.app

# ── Google como proveedor (OPCIONAL) ────────────────────────────────────────
# El login con Google solo se habilita si defines AMBAS. Déjalas vacías para
# usar solo correo/contraseña.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Zona horaria ────────────────────────────────────────────────────────────
# instrumentation.ts la fija a America/Tegucigalpa si no viene del entorno, pero
# en producción conviene declararla explícita.
TZ=America/Tegucigalpa
