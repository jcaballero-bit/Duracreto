# Respaldo diario. Va en /etc/systemd/system/duracreto-backup.service
[Unit]
Description=Respaldo de la base de datos DPCR-08
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=duracreto
EnvironmentFile=/etc/duracreto/env
Environment=TZ=America/Tegucigalpa
ExecStart=/opt/duracreto/deploy/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duracreto-backup
